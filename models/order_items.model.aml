Model order_items {
  type: 'table'
  label: 'Order Items'
  description: 'One row per product line in an order. The grain for all money metrics.'
  data_source_name: 'supabase'
  table_name: '"ecommerce"."order_items"'

  dimension id {
    label: 'Order Item ID'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.id }};;
  }
  dimension order_id {
    label: 'Order ID'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.order_id }};;
  }
  dimension product_id {
    label: 'Product ID'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.product_id }};;
  }
  dimension quantity {
    label: 'Quantity'
    type: 'number'
    definition: @sql {{ #SOURCE.quantity }};;
  }
  dimension unit_price {
    label: 'Unit Price'
    type: 'number'
    description: 'Price per unit at the time of the order, before discount.'
    definition: @sql {{ #SOURCE.unit_price }};;
  }
  dimension discount {
    label: 'Discount per Unit'
    type: 'number'
    definition: @sql {{ #SOURCE.discount }};;
  }
  dimension gross_amount {
    label: 'Gross Amount'
    type: 'number'
    description: 'quantity x unit_price'
    definition: @sql {{ #SOURCE.quantity }} * {{ #SOURCE.unit_price }};;
  }
  dimension net_amount {
    label: 'Net Amount'
    type: 'number'
    description: 'quantity x (unit_price - discount)'
    definition: @sql {{ #SOURCE.quantity }} * ({{ #SOURCE.unit_price }} - {{ #SOURCE.discount }});;
  }

  measure units_sold {
    label: 'Units Sold'
    type: 'number'
    definition: @sql {{ quantity }};;
    aggregation_type: 'sum'
  }
}
